{
  "name": "@suil0304/suil-lints",
  "version": "0.3.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "bun tsc --noEmit --project ./tsconfig.build.json",
    "lint": "bun x --bun eslint",
    "build": "bun tsc --project ./tsconfig.build.json",
    "release": "bun pm pack --destination ./release"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "@types/bun": "latest",
    "eslint": "^10.13.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "exports": {
    "./eslint": {
      "import": "./dist/configs/eslint/index.js",
      "types": "./dist/configs/eslint/index.d.ts"
    },
    "./eslint/utils": {
      "import": "./dist/configs/eslint/utils/index.js",
      "types": "./dist/configs/eslint/utils/index.d.ts"
    },
    "./stylelint": {
      "import": "./dist/configs/stylelint/index.js",
      "types": "./dist/configs/stylelint/index.d.ts"
    },
    "./stylelint/base": {
      "import": "./dist/configs/stylelint/base.js",
      "types": "./dist/configs/stylelint/base.d.ts"
    },
    "./stylelint/scss": {
      "import": "./dist/configs/stylelint/scss.js",
      "types": "./dist/configs/stylelint/scss.d.ts"
    }
  },
  "private": true,
  "type": "module"
}
